# =============================================================================
# Swipet — example environment
# Copy this file to `.env` (NEVER commit `.env` — it is in `.gitignore`).
#
# `docker compose up` reads `.env` automatically; backend / chat-service
# references resolve to these variables.
# =============================================================================

# ----------------------------- PostgreSQL ------------------------------------
POSTGRES_DB=swipet
POSTGRES_USER=swipet_user
POSTGRES_PASSWORD=change-me-in-local-only
# Host port that maps to container 5432 (handy when you run `psql` locally).
POSTGRES_PORT=5432

# ----------------------------- JWT (auth) ------------------------------------
# >= 256 bit. Generate locally via:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48-min-256-bit-secret
JWT_ACCESS_EXPIRATION=900        # seconds (15 min)
JWT_REFRESH_EXPIRATION=604800    # seconds (7 days)
JWT_ISSUER=swipet-backend

# ----------------------------- MinIO (S3-compatible) ------------------------
MINIO_ROOT_USER=swipet-minio
MINIO_ROOT_PASSWORD=change-me-in-local-only
MINIO_BUCKET=swipet-media
# URL that the *client* uses to reach uploaded objects.
# Served through nginx (/media/ -> minio) so web avatars are same-origin https
# and don't trip browser mixed-content blocking. In prod replace with your CDN/S3.
MINIO_PUBLIC_URL=https://localhost/media
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ----------------------------- Reverse proxy --------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# ----------------------------- Backend / API --------------------------------
# Optional: expose backend directly on the host (skipping nginx) for debugging.
BACKEND_PORT=8080
# Comma-separated list of CORS-allowed origins.
FRONTEND_URL=http://localhost:8081,http://localhost:19006

# ----------------------------- Chat service ---------------------------------
CHAT_PORT=3001

# ----------------------------- Stripe (payments) ----------------------------
# Secret API key (sk_test_… locally, sk_live_… in prod).
STRIPE_API_KEY=sk_test_replace_me
# Webhook signing secret from `stripe listen` / dashboard (whsec_…).
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Single public origin used for Stripe success/cancel redirect — MUST match the
# origin where the user is logged in, otherwise verify-session loses the session.
APP_PUBLIC_URL=https://localhost

# ----------------------------- React Native (Expo) --------------------------
# Consumed by the web build as docker-compose build args (Expo inlines
# EXPO_PUBLIC_* at build time). Must be https to match the nginx TLS origin
# and avoid browser mixed-content blocking.
EXPO_PUBLIC_API_URL=https://localhost/api/v1
EXPO_PUBLIC_SOCKET_URL=https://localhost
