#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/swipet-bootstrap.log) 2>&1
echo "[swipet] bootstrap started $(date -u)"

REGION="${aws_region}"
PREFIX="${ssm_prefix}"

get_secret() {
  aws ssm get-parameter --region "$REGION" --name "$1" --with-decryption \
    --query 'Parameter.Value' --output text
}

# --- packages --------------------------------------------------------------
dnf update -y
dnf install -y docker
systemctl enable --now docker

# docker compose v2 plugin (not packaged on AL2023)
mkdir -p /usr/libexec/docker/cli-plugins
curl -fsSL https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64 \
  -o /usr/libexec/docker/cli-plugins/docker-compose
chmod +x /usr/libexec/docker/cli-plugins/docker-compose

# --- swap (safety buffer for JVM on a 2 GiB box) ---------------------------
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

mkdir -p /opt/swipet

# --- secrets from SSM Parameter Store --------------------------------------
DB_PASSWORD="$(get_secret "$PREFIX/db_password")"
JWT_SECRET="$(get_secret "$PREFIX/jwt_secret")"
S3_ACCESS_KEY="$(get_secret "$PREFIX/s3_access_key")"
S3_SECRET_KEY="$(get_secret "$PREFIX/s3_secret_key")"
STRIPE_API_KEY="$(get_secret "$PREFIX/stripe_api_key")"
STRIPE_WEBHOOK_SECRET="$(get_secret "$PREFIX/stripe_webhook_secret")"

# --- render runtime env ----------------------------------------------------
cat > /opt/swipet/.env <<ENV
BACKEND_IMAGE=${backend_image}
CHAT_IMAGE=${chat_image}
POSTGRES_HOST=${db_host}
POSTGRES_PORT=${db_port}
POSTGRES_DB=${db_name}
POSTGRES_USER=${db_user}
POSTGRES_PASSWORD=$DB_PASSWORD
PGDATA=/var/lib/postgresql/data/pgdata
JWT_SECRET=$JWT_SECRET
JWT_ISSUER=${jwt_issuer}
MINIO_ENDPOINT=${s3_endpoint}
MINIO_PUBLIC_URL=${s3_endpoint}
MINIO_REGION=${s3_region}
MINIO_BUCKET=${bucket}
MINIO_ACCESS_KEY=$S3_ACCESS_KEY
MINIO_SECRET_KEY=$S3_SECRET_KEY
STRIPE_API_KEY=$STRIPE_API_KEY
STRIPE_WEBHOOK_SECRET=$STRIPE_WEBHOOK_SECRET
APP_PUBLIC_URL=${app_public_url}
FRONTEND_URL=${frontend_url}
ENV
chmod 600 /opt/swipet/.env

# --- compose file (rendered by Terraform; $${VAR} resolved by compose) -----
cat > /opt/swipet/docker-compose.yml <<'COMPOSE'
${compose_file}
COMPOSE

# --- Caddy: HTTPS termination + reverse proxy ------------------------------
# Bring Caddy up BEFORE docker compose so the public HTTPS endpoint exists even
# when an image pull fails — you then get a debuggable 502 instead of a dead
# port 443.
# Note: a bare `[ ... ] && cmd` would exit non-zero under `set -e` when the test
# is false (x86_64), aborting the whole script. Use an explicit if instead.
ARCH=amd64
if [ "$(uname -m)" = "aarch64" ]; then ARCH=arm64; fi
curl -fsSL -o /usr/local/bin/caddy "https://caddyserver.com/api/download?os=linux&arch=$ARCH"
chmod +x /usr/local/bin/caddy

mkdir -p /etc/caddy
: > /etc/caddy/Caddyfile

if [ "${custom_tls}" = "true" ]; then
  # Static wildcard cert (does NOT auto-renew).
  mkdir -p /etc/caddy/tls
  get_secret "$PREFIX/tls_cert" > /etc/caddy/tls/cert.pem
  get_secret "$PREFIX/tls_key"  > /etc/caddy/tls/key.pem
  chmod 600 /etc/caddy/tls/key.pem
  TLS_LINE="tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem"
else
  # Caddy auto-HTTPS (ACME) — obtains AND auto-renews certs. Needs port 80
  # reachable + valid public DNS (both set up by Terraform).
  TLS_LINE=""
  if [ -n "${acme_email}" ]; then
    printf '{\n  email %s\n}\n\n' "${acme_email}" >> /etc/caddy/Caddyfile
  fi
fi

cat >> /etc/caddy/Caddyfile <<CADDY
${backend_fqdn} {
  $TLS_LINE
  reverse_proxy localhost:8080
}

${chat_fqdn} {
  $TLS_LINE
  reverse_proxy localhost:3001
}
CADDY

cat > /etc/systemd/system/caddy.service <<'CADDY_SVC'
[Unit]
Description=Caddy
After=network.target

[Service]
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
CADDY_SVC

systemctl daemon-reload
systemctl enable caddy
systemctl restart caddy

# --- pull and start (images are public; no Docker Hub login needed) --------
# Non-fatal: a bad image name/tag must not abort bootstrap and leave Caddy down,
# but we DO retry (the :latest tag may still be publishing on a fresh deploy)
# and log the resolved image names + final state so failures aren't silent.
cd /opt/swipet
echo "[swipet] images: BACKEND=${backend_image} CHAT=${chat_image}"

pull_ok=""
for attempt in 1 2 3 4 5; do
  if docker compose pull; then
    pull_ok="yes"
    break
  fi
  echo "[swipet] WARN: docker compose pull failed (attempt $attempt/5) — retrying in 20s"
  sleep 20
done
[ -n "$pull_ok" ] || echo "[swipet] ERROR: image pull failed after retries — check that ${backend_image} / ${chat_image} exist and are public"

docker compose up -d || echo "[swipet] ERROR: docker compose up failed"

# Surface the real state into the bootstrap log for debugging.
sleep 5
docker compose ps || true

echo "[swipet] bootstrap finished $(date -u)"
