{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://swipet-api.naukma.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://chat.swipet.naukma.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://swipet-api.naukma.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://chat.swipet.naukma.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://swipet-api.naukma.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://chat.swipet.naukma.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
