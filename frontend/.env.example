# Cloud (deployed) backends. Expo inlines EXPO_PUBLIC_* into the bundle at
# build/start time — restart `expo start` with -c after changing these.
EXPO_PUBLIC_API_URL=https://api.swipet.naukma.com/api/v1
EXPO_PUBLIC_SOCKET_URL=https://chat.swipet.naukma.com

# Local dev against a backend on your machine (uncomment to use instead):
# EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
# EXPO_PUBLIC_SOCKET_URL=http://localhost:3001
